<div id="instructor-scores">
<% if @feedback_scores %>
  <% if @placement_scores %>
  <h2 class="font-bold pt-4 text-2xl pb-5">Feedback</h2>
  <% end %>
  <table class="mb-8">
    <thead>
      <tr>
        <th class="row-head">Name
        <th class="row-head">Heats
        <% @feedback_items.each do |abbr, name| %>
        <th class="row-head"><abbr title="<%= name %>"><%= abbr %></abbr>
        <% end %>
      </tr>
    </thead>
    <% @feedback_scores.sort_by {|person, results| -results['heats']}.each do |person, results| %>
    <tr>
      <td class="row-main"><%= link_to person.display_name, person %></td>
      <td class="row text-right px-4"><%= results['heats'] %></td>
      <% @feedback_items.each do |abbr, name| %>
      <td class="row text-center px-2">
        <% good = results['good'][abbr] %>
        <% bad = results['bad'][abbr] %>
        <% if good > 0 %><div class="text-green-600"><%= good %></div><% end %>
        <% if bad > 0 %><div class="text-red-600"><%= bad %></div><% end %>
      </td>
      <% end %>
    </tr>
    <% end %>
  </table>

  <table class="ml-8 w-full mb-8">
  <% if Feedback.any? %>
    <% Feedback.ordered.each_slice(5) do |feedbacks| %>
    <tr>
      <% feedbacks.each do |feedback| %>
        <td><abbr><%= feedback.abbr %></abbr>: <span><%= feedback.value %></span></td>
      <% end %>
    </tr>
    <% end %>
  <% else %>
    <% @feedback_items.each_slice(5) do |items| %>
    <tr>
      <% items.each do |abbr, name| %>
        <td><abbr><%= abbr %></abbr>: <span><%= name %></span></td>
      <% end %>
    </tr>
    <% end %>
  <% end %>
  </table>
<% end %>

<% if @placement_scores %>
  <% if @feedback_scores %>
  <h2 class="font-bold pt-4 text-2xl pb-5">Points</h2>
  <% end %>
  <table class="mb-8">
    <thead>
          <% if @tabulator.labeled? %>
          <tr>
            <th colspan="2">
            <% @tabulator.buckets.each do |bucket| %>
            <th colspan="<%= bucket.width %>" class="<%= 'bg-slate-200' if bucket.shaded? %>"><%= bucket.category %>
            <% end %>
          </tr>
          <% end %>

          <tr>
          <th class="row-head">Points
          <th class="row-head">Name
          <% @tabulator.buckets.each do |bucket| %>
          <% bucket.headers.each do |score| %>
          <th class="row-head <%= 'bg-slate-200' if bucket.shaded? %>"><%= score %>
          <% end %>
          <% end %>
          </tr>
    </thead>
    <% @placement_scores.sort_by {|person, results| results['points']}.reverse.each do |person, results| %>
    <tr>
      <td class="row-main text-right"><%= results['points'] %>
      <td class="row-main"><%= link_to person.display_name, person %></td>
      <% @tabulator.buckets.each do |bucket| %>
      <% results[bucket.category].each do |score| %>
      <td class="row text-right px-4 <%= 'bg-slate-200' if bucket.shaded? %>"><%= score == 0 ? '' : score %></td>
      <% end %>
      <% end %>
    </tr>
    <% end %>
  </table>
<% end %>

  <% if @feedback_scores.blank? && @placement_scores.blank? %>
  <p class="my-8">No scores entered yet.</p>
  <% end %>
</div>
