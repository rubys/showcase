<% # Feedback-only scoring records no values to tally, so there are no columns %>
<% unless scores.empty? || score_columns.empty? %>
<table>
<caption class="text-left font-bold pt-8 text-3xl pb-5">Scores</caption>

<thead>
<th class="row-head">Dance<% Event.current.student_judge_assignments? ? '/Category' : '' %></th>
<% score_columns.each do |column| %>
  <th class="row-head <%= 'bg-slate-200' if column.shaded %>"><%= column.label %>
<% end %>
</thead>

<tbody>
<% # Show per-heat scores (dances) %>
<% dances.each do |dance, partners| %>
  <% values = scores[dance.id] %>
  <% next unless values %>
  <tr>
    <td class="row"><%= dance.name %>
    <% score_columns.each do |column| %>
    <td class="row text-right px-4 <%= 'bg-slate-200' if column.shaded %>"><%= values[column.key] || '' %></td>
    <% end %>
  </tr>
<% end %>

<% # Show category scores %>
<% if defined?(@categories) && @categories %>
  <% @categories.each do |cat_id, category| %>
    <% values = scores[-cat_id] %>
    <% next unless values %>
    <tr class="bg-blue-50">
      <td class="row"><%= category.name %>
      <% score_columns.each do |column| %>
      <td class="row text-right px-4 <%= 'bg-slate-200' if column.shaded %>"><%= values[column.key] || '' %></td>
      <% end %>
    </tr>
  <% end %>
<% end %>
</tbody>
</table>
<% end %>
